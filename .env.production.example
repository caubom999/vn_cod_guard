# This file belongs on the production server as .env.production.
# Never commit the real values.

APP_IMAGE=registry.gitlab.com/your-group/vn-cod-guard:latest
APP_PORT=8080
HOST=https://vtjr.online
APP_SCHEME=https

SHOPIFY_API_KEY=6e41fd433a097099c22bf697ca13e998
SHOPIFY_API_SECRET=replace_with_a_rotated_shopify_api_secret
INTEGRATION_ENCRYPTION_KEY=replace_with_a_different_32_character_random_secret
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_delivery_customizations,read_order_edits,read_orders,read_payment_customizations,read_products,read_shipping,read_translations,write_delivery_customizations,write_order_edits,write_orders,write_payment_customizations
SHOPIFY_BILLING_TEST=false

MYSQL_ROOT_PASSWORD=replace_with_a_long_random_password
MYSQL_DATABASE=vn_cod_guard
MYSQL_APP_USER=vn_cod_guard
MYSQL_APP_PASSWORD=replace_with_a_long_random_password

REDIS_PASSWORD=replace_with_a_long_random_password
REDIS_DATABASE=0
SHOPIFY_SESSION_STORAGE=redis
SHOPIFY_SESSION_REDIS_KEY_PREFIX=shopify_sessions

COD_AUTOMATION_WORKER_ENABLED=true
COD_AUTOMATION_WORKER_INTERVAL_MS=30000
COD_AUTOMATION_WORKER_BATCH_SIZE=10
COD_AUTOMATION_WORKER_MAX_ATTEMPTS=3
COD_AUTOMATION_WORKER_STALE_RUNNING_MS=600000
COD_AUTOMATION_WORKER_RETRY_BASE_MS=60000
COD_AUTOMATION_WORKER_RETRY_MAX_MS=900000
COD_AVERAGE_SHIPPING_COST=30000

EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_with_a_rotated_resend_api_key
EMAIL_FROM=confirm@vtjr.online
EMAIL_REPLY_TO=support@vtjr.online
SUPPORT_EMAIL=support@vtjr.online

# Optional platform-owned Twilio fallback. Merchant-owned Twilio credentials
# are configured in the app and encrypted with INTEGRATION_ENCRYPTION_KEY.
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM=replace_with_registered_sender
# Enable only after the sms_sent meter is active in Shopify App Pricing.
SHOPIFY_SMS_USAGE_BILLING_ENABLED=false
SMS_USAGE_EVENT_HANDLE=sms_sent
