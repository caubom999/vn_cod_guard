{% if block.settings.enabled %}
  <script>
    window.VnCodGuard = {
      shop: {{ shop.permanent_domain | json }},
    };
  </script>
{% endif %}

{% schema %}
{
  "name": "VN-Cod-Guard app embed",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable app embed",
      "default": true
    }
  ]
}
{% endschema %}
