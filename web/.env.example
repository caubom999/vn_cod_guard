PORT=8081
HOST=https://your-tunnel-url.trycloudflare.com
APP_SCHEME=https

SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_products,read_orders,write_orders

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3309
MYSQL_DATABASE=vn_cod_guard
MYSQL_USER=base_app
MYSQL_PASSWORD=base_app_secret
DATABASE_URL=mysql://vn_cod_guard:base_app_secret@127.0.0.1:3309/vn_cod_guard

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DATABASE=0
SHOPIFY_SESSION_STORAGE=redis
SHOPIFY_SESSION_REDIS_KEY_PREFIX=shopify_sessions

COD_AUTOMATION_WORKER_ENABLED=true
COD_AUTOMATION_WORKER_INTERVAL_MS=30000
COD_AUTOMATION_WORKER_BATCH_SIZE=10
COD_AUTOMATION_WORKER_MAX_ATTEMPTS=3
COD_AUTOMATION_WORKER_STALE_RUNNING_MS=600000
COD_AUTOMATION_WORKER_RETRY_BASE_MS=60000
COD_AUTOMATION_WORKER_RETRY_MAX_MS=900000
COD_AVERAGE_SHIPPING_COST=30000
SHOPIFY_BILLING_TEST=true

EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_REPLY_TO=
SUPPORT_EMAIL=support@vietnamcodguard.com
